# Образ готового сайта: nginx и статика, больше ничего.
#
# Контекст сборки — уже собранная папка out/<сайт>-<окружение>, а не папка
# контента. Так в образ физически не может попасть ни .git, ни исходники
# картинок, ни макеты, и движка в работающем контейнере нет: в сети не
# должно стоять ничего, что умеет читать файлы сайта и запускать плагины.
#
# Собирается через scripts/site.sh <сайт> image <окружение>.

FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL org.opencontainers.image.source="https://github.com/FMSTM/HERON"

COPY . /usr/share/nginx/html

EXPOSE 8080
