# Образ готового сайта: nginx и статика, больше ничего.
#
# Контекст сборки — уже собранная папка out/<сайт>-<окружение>, а не папка
# контента. Так в образ физически не может попасть ни .git, ни исходники
# картинок, ни макеты, и движка в работающем контейнере нет: в сети не
# должно стоять ничего, что умеет читать файлы сайта и запускать плагины.
#
# Собирается через scripts/site.sh <сайт> image <окружение>.

FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL org.opencontainers.image.source="https://github.com/FMSTM/HERON"

# Конфиг nginx приезжает вместе со статикой: движок собирает его под языки
# этого сайта. Руками написанный список языков разошёлся бы с содержимым
# папки в первый же раз, когда сменят основной язык.
#
# Зачем он вообще: у образа по умолчанию не задан error_page, поэтому на
# несуществующий адрес отдаётся встроенная страница nginx, а нарисованную
# темой 404 не видит никто. Код ответа остаётся 404: заглушка с кодом 200
# попадает в индекс и плодит дубли.
USER root

COPY . /usr/share/nginx/html

# Права приезжают вместе с файлами, а nginx работает не под root: папка,
# закрытая от чужих на машине сборки, внутри образа превращается в 403 на
# весь сайт. Поэтому читаемость выставляем здесь, а не надеемся на умаск
# того, кто собирал.
#
# Владельца конфига меняем не для красоты: стартовый скрипт образа правит
# default.conf на месте (ipv6, резолверы), и от чужого файла он получает
# отказ в правах — контейнер падает сразу после старта.
RUN set -eu; \
    conf=/usr/share/nginx/html/.heron-nginx.conf; \
    if [ ! -f "$conf" ]; then \
      echo "нет $conf — пересоберите сайт движком 0.4.0 или новее"; exit 1; \
    fi; \
    mv "$conf" /etc/nginx/conf.d/default.conf; \
    chown nginx:nginx /etc/nginx/conf.d/default.conf; \
    chmod -R a+rX /usr/share/nginx/html

USER nginx

# Проверка конфига идёт под тем же пользователем, под которым потом работает
# сервер. Под root она врёт дважды: не видит отказов в правах и оставляет за
# собой /tmp/nginx.pid, в который рабочий процесс потом не может писать —
# контейнер падает на старте с «permission denied».
RUN nginx -t -c /etc/nginx/nginx.conf && rm -f /tmp/nginx.pid

EXPOSE 8080
