# Окружение сборки сайта.
#
# Файл называется .env.<сайт>.<окружение>: .env.mysite.dev, .env.mysite.prod.
# Настоящие файлы в гит не попадают (.gitignore), в гите живёт только
# этот пример — имена сайтов ядру знать незачем.
#
# Здесь ТОЛЬКО то, что зависит от машины и окружения, либо секретно.
# Всё публичное — домен, языки, меню, версия движка, ID Метрики и GTM —
# лежит в site.yaml рядом с контентом.
#
# Две настройки ниже про РАЗНОЕ, и путать их не надо:
#   SITE_ENV — каким будет САЙТ: закрыт от индексации или открыт;
#   ENGINE   — каким ДВИЖКОМ его собрать.
# Дев-сайт собирается стабильным движком. Сырой движок берут только
# тогда, когда занимаются самим движком.

# --- где лежит контент ---------------------------------------------------
# Абсолютный путь к папке сайта. Монтируется только на чтение.
SITE_PATH=/Users/you/SOURCE/MYSITE

# --- каким будет сайт ----------------------------------------------------
# prod открывает индексацию и счётчики, любое другое имя — нет.
SITE_ENV=dev

# Необязательные перебивки. Нужны для прод-подобного превью:
# собрать как прод, но закрыть от поисковиков.
# SITE_INDEXABLE=false
# SITE_ANALYTICS=false

# Строгая сборка: предупреждения становятся ошибками. Для прода — да.
STRICT=false

# --- каким движком собирать ----------------------------------------------
# Пусто — движок выбирается так: точная версия из site.yaml сайта; иначе
# исходники движка, если они лежат рядом; иначе стабильный prod.
# Дев и стейдж движка сами по себе не подхватываются никогда.
#
#   local          собрать из исходников этой папки — для работы над движком
#   dev | stage    сырые ветки движка — только если вы его и разрабатываете
#   prod           стабильный, им собирают сайты
#   0.1.0          конкретная версия
# ENGINE=prod

# Совсем явно, если нужен конкретный образ:
# HERON_IMAGE=ghcr.io/fmstm/heron:0.1.0

# --- упаковка в образ ----------------------------------------------------
IMAGE_NAME=heron-site-mysite
IMAGE_TAG=dev

# Реестр для push. Пусто — push запрещён (чтобы дев не уехал в реестр).
REGISTRY=

# --- просмотр ------------------------------------------------------------
PORT=8080

# --- секреты -------------------------------------------------------------
# Сюда — токены деплоя и приватных источников данных.
# SMTP и прочие пароли форм сюда НЕ кладём: сборка статическая, всё, что
# она видит, может оказаться в HTML. Формы обрабатывает отдельный сервис
# со своими переменными.
