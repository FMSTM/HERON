# Окружение сборки сайта.
#
# Файл называется .env.<сайт>.<окружение>: .env.mysite.dev, .env.mysite.prod.
# Настоящие файлы в гит не попадают (.gitignore), в гите живёт только
# этот пример — имена сайтов ядру знать незачем.
#
# Здесь ТОЛЬКО то, что зависит от машины и окружения, либо секретно.
# Всё публичное — домен, языки, меню, версия движка, ID Метрики и GTM —
# лежит в site.yaml рядом с контентом. Иначе один и тот же сайт на двух
# машинах соберётся по-разному.

# --- где лежит контент ---------------------------------------------------
# Абсолютный путь к папке сайта. Монтируется только на чтение.
SITE_PATH=/Users/you/SOURCE/MYSITE

# --- что видит внешний мир -----------------------------------------------
# Имя окружения. prod открывает индексацию и счётчики, любое другое — нет.
HERON_ENV=dev

# Необязательные перебивки. Нужны для прод-подобного превью:
# собрать как прод, но закрыть от поисковиков.
# HERON_INDEXABLE=false
# HERON_ANALYTICS=false

# Строгая сборка: предупреждения становятся ошибками. Для прода — да.
STRICT=false

# --- упаковка в образ ----------------------------------------------------
IMAGE_NAME=heron-site-mysite
IMAGE_TAG=dev

# Реестр для push. Пусто — push запрещён (чтобы дев не уехал в реестр).
REGISTRY=

# --- просмотр ------------------------------------------------------------
PORT=8080

# --- секреты -------------------------------------------------------------
# Сюда — токены деплоя и приватных источников данных.
# SMTP и прочие пароли форм сюда НЕ кладём: сборка статическая, всё, что
# она видит, может оказаться в HTML. Формы обрабатывает отдельный сервис
# со своими переменными.
