# Что НЕ едет в контекст сборки образа. Докер пакует папку целиком и
# отправляет демону до первой команды Dockerfile, поэтому лишнее здесь —
# это не место в образе, а секунды (или минуты) молчания на каждой сборке.
#
# out/ особенно: там лежат собранные сайты и кэш нарезок, сотни мегабайт,
# и растут они сами по себе.
out/
dist/
.heron-cache/

# Окружения сайтов: пути конкретной машины и доступы к реестрам. В образ
# они не попадают, но и демону их передавать незачем.
env/

.git/
.github/
tests/
# из docs/ в образ идёт только текст — для `heron docs`; картинки бренда — нет
docs/brand/
.venv/
.ruff_cache/
.pytest_cache/
__pycache__/
*.egg-info/
.DS_Store
